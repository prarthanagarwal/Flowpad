{
  "name": "flowpad",
  "version": "1.8.2",
  "description": "a minimal notepad for your thoughts to flow",
  "productName": "flowpad",
  "author": {
    "name": "Prarthan Agarwal",
    "email": "developer@flowpad.com"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electronmon .",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "build:win": "electron-forge make --platform=win32 --arch=x64",
    "build:mac": "electron-forge make --platform=darwin --arch=arm64",
    "build:mac:intel": "electron-forge make --platform=darwin --arch=x64",
    "build:mac:full": "bash scripts/build-and-notarize.sh",
    "lint": "cross-env NODE_OPTIONS=\"--import tsx\" oxlint",
    "test": "node --test tests/storage.test.cjs && playwright test",
    "test:unit": "node --test tests/storage.test.cjs",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "electron",
    "notes",
    "productivity",
    "writing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PrarthanAgarwal/Flowpad.git"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@oxlint/plugins": "^1.79.0",
    "@playwright/test": "^1.64.1",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electronmon": "^2.0.3",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "vite": "^7.3.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.1.0",
    "linkedom": "^0.18.14",
    "marked": "^18.1.2",
    "turndown": "^7.2.4",
    "update-electron-app": "^3.1.1"
  }
}
